# All variables are optional. The site builds and runs with none of them set.

# Canonical origin used for metadata, sitemap, JSON-LD and llms.txt.
NEXT_PUBLIC_SITE_URL=https://pshah.fun

# Google Search Console verification token (meta tag). Omit to skip the tag.
NEXT_PUBLIC_GOOGLE_VERIFICATION=

# GitHub token (no scopes needed) to raise the API rate limit for the Open source section.
# Without it the section uses anonymous requests, cached for 6 hours, with a static fallback.
GITHUB_TOKEN=

# Enables AI answers in the "Ask about my work" panel. Server-side only; never exposed to the browser.
# Without it the panel answers by quoting the matching site content.
# Set a monthly spend limit on this key in the Anthropic Console.
ANTHROPIC_API_KEY=

# Model for the assistant. Defaults to claude-opus-5. For lower cost per question,
# claude-haiku-4-5 or claude-sonnet-5 also work well for short grounded answers.
ASSISTANT_MODEL=

# Visitor counter in the footer. Set automatically when you connect an Upstash Redis store
# in Vercel (Storage tab → Upstash → Redis, free tier). Without them the counter is hidden.
KV_REST_API_URL=
KV_REST_API_TOKEN=
